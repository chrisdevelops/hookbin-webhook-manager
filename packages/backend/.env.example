# Hookbin Backend Environment Configuration
# Copy this file to .env and configure as needed

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the backend server (default: 3001)
PORT=3001

# Path to SQLite database file (default: ./data/hookbin.db)
DATABASE_PATH=./data/hookbin.db

# =============================================================================
# Authentication Configuration (Optional)
# =============================================================================

# Enable authentication for the dashboard (default: false)
# When false, all routes remain publicly accessible
# When true, SESSION_SECRET is required
AUTH_ENABLED=false

# Session secret for secure cookies (REQUIRED when AUTH_ENABLED=true)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Never commit this value to version control
SESSION_SECRET=

# Initial admin user credentials (used on first startup when AUTH_ENABLED=true)
# The admin user is created automatically if it doesn't exist
INITIAL_USERNAME=admin

# Password for initial admin user (REQUIRED when AUTH_ENABLED=true)
# IMPORTANT: Never commit this value to version control
INITIAL_PASSWORD=
